# Copie para backend/.env (nunca versionado) e preencha.
NODE_ENV=development
PORT=3000

# Postgres do docker-compose. Dentro do Docker o host é "postgres" (porta 5432);
# rodando o backend fora do Docker (npm run start:dev), use localhost:5433.
DATABASE_URL=postgresql://habitos:habitos_dev_password@localhost:5433/app_de_habitos?schema=public

# URL do frontend (CORS)
FRONTEND_URL=http://localhost:5174

# Quantos proxies reversos confiáveis ficam na frente do backend (0 = nenhum)
TRUST_PROXY_HOPS=0

# Sessão. Gere um segredo aleatório com, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=10

# Senha do app (conta única). Fica SÓ aqui e no painel do provedor em produção;
# o banco guarda apenas o hash. Mudar este valor e reiniciar o backend troca a senha
# e encerra as sessões abertas. Mínimo 8 caracteres.
ADMIN_PASSWORD=
